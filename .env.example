# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ==============================================================================
# ONE HEALTH MANIEMA (V1.23) — CONFIGURATION CLOUD CIBLE (GOOGLE CLOUD COMPATIBLE)
# ==============================================================================
# Note: Ces variables servent de modèle pour le futur déploiement réel.
# AUCUN SECRET RÉEL NE DOIT ÊTRE INSCRIT DANS CE FICHIER.

# Environnement d'exécution : 'development' | 'staging' | 'production'
APP_ENV=development

# Niveau de journalisation structurée : 'debug' | 'info' | 'warn' | 'error'
LOG_LEVEL=info

# Région cloud cible (par défaut: Johannesburg / africa-south1)
CLOUD_TARGET_REGION=africa-south1

# Base de données PostgreSQL (Cloud SQL ou instance dédiée)
# Format cible: postgresql://[DB_USER]:[DB_PASSWORD]@[DB_HOST]:5432/[DB_NAME]?sslmode=require
DATABASE_URL=postgresql://oh_user:changeme@127.0.0.1:5432/onehealth_maniema_dev?sslmode=disable
DB_POOL_MAX=20
DB_TIMEOUT_MS=10000

# Fournisseur de stockage d'objets (Photos terrain, GeoTIFF, exports volumineux)
# Options: 'LOCAL_INDEXEDDB' | 'GOOGLE_CLOUD_STORAGE' | 'S3_COMPATIBLE'
STORAGE_PROVIDER=LOCAL_INDEXEDDB
STORAGE_BUCKET=onehealth-maniema-media-dev
STORAGE_REGION=africa-south1

# Synchronisation & Résilience Offline
SYNC_RETRY_MAX=5
SYNC_BACKOFF_BASE_MS=1000
SYNC_TIMEOUT_MS=30000

# Headers & Sécurité
CORS_ALLOWED_ORIGINS=http://localhost:3000
RATE_LIMIT_MAX_REQUESTS_PER_MIN=120

